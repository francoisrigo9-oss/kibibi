```css
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

:root {
    --blue: #1877f2;
    --blue-dark: #0d65d9;
    --background: #f0f2f5;
    --white: #ffffff;
    --text: #1c1e21;
    --muted: #65676b;
    --border: #dddfe2;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background: var(--background);
    color: var(--text);
    transition: .25s;
}

/* LOGO */

.logo {
    width: 43px;
    height: 43px;
    border-radius: 50%;
    background: linear-gradient(145deg,#2d8cff,#0755bd);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 29px;
    font-weight: 900;
    box-shadow: 0 4px 12px rgba(24,119,242,.30);
}

.brand {
    display: flex;
    align-items: center;
    gap: 9px;
    cursor: pointer;
    font-size: 25px;
}

/* HEADER */

.topbar {
    position: fixed;
    z-index: 1000;
    top: 0;
    left: 0;
    right: 0;
    height: 66px;
    background: white;
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 22px;
}

.search {
    width: 380px;
    height: 42px;
    background: var(--background);
    border-radius: 25px;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 0 15px;
}

.search input {
    width: 100%;
    border: none;
    outline: none;
    background: transparent;
}

.top-buttons {
    display: flex;
    gap: 8px;
}

.top-buttons button {
    width: 42px;
    height: 42px;
    border: none;
    border-radius: 50%;
    background: var(--background);
    cursor: pointer;
    font-size: 18px;
}

/* SIDEBAR */

.sidebar {
    position: fixed;
    top: 66px;
    bottom: 0;
    left: 0;
    width: 245px;
    background: white;
    border-right: 1px solid var(--border);
    padding: 20px 14px;
}

.user {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px;
    margin-bottom: 12px;
}

.user img {
    width: 45px;
    height: 45px;
    border-radius: 50%;
}

.user small {
    display: block;
    color: var(--muted);
}

.sidebar > button {
    width: 100%;
    padding: 13px;
    border: none;
    background: transparent;
    text-align: left;
    border-radius: 10px;
    cursor: pointer;
    font-size: 15px;
}

.sidebar > button:hover {
    background: var(--background);
}

.sidebar hr {
    border: 0;
    border-top: 1px solid var(--border);
    margin: 15px 0;
}

/* MAIN */

main {
    margin-left: 245px;
    padding: 90px 25px;
    max-width: 1050px;
}

.page {
    display: none;
}

.page.active {
    display: block;
}

/* HERO */

.hero {
    min-height: 170px;
    border-radius: 18px;
    padding: 30px;
    margin-bottom: 20px;
    background: linear-gradient(135deg,#1877f2,#0755bd);
    color: white;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.hero h1 {
    margin-bottom: 8px;
}

.big-logo {
    width: 95px;
    height: 95px;
    background: white;
    color: var(--blue);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 62px;
    font-weight: 900;
}

/* CREATE POST */

.create {
    background: white;
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 16px;
    margin-bottom: 20px;
}

.create-row {
    display: flex;
    gap: 12px;
    align-items: center;
}

.create-row img {
    width: 45px;
    height: 45px;
    border-radius: 50%;
}

.create-row input {
    flex: 1;
    border: none;
    outline: none;
    background: var(--background);
    padding: 13px 18px;
    border-radius: 25px;
}

.create-actions {
    display: flex;
    gap: 8px;
    border-top: 1px solid var(--border);
    margin-top: 14px;
    padding-top: 12px;
}

.create-actions button {
    border: none;
    background: transparent;
    padding: 10px 14px;
    border-radius: 8px;
    cursor: pointer;
}

.create-actions button:hover {
    background: var(--background);
}

.create-actions .publish {
    margin-left: auto;
    background: var(--blue);
    color: white;
}

/* POSTS */

.post {
    background: white;
    border: 1px solid var(--border);
    border-radius: 14px;
    margin-bottom: 18px;
    overflow: hidden;
}

.post-head {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px;
}

.post-head img {
    width: 45px;
    height: 45px;
    border-radius: 50%;
}

.post-head small {
    display: block;
    color: var(--muted);
    margin-top: 3px;
}

.more {
    margin-left: auto;
    border: none;
    background: transparent;
    font-size: 20px;
}

.post > p {
    padding: 0 16px 16px;
    line-height: 1.6;
}

.post-image {
    width: 100%;
    max-height: 550px;
    object-fit: cover;
}

.post-info {
    padding: 12px 16px;
    color: var(--muted);
    font-size: 13px;
}

.post-buttons {
    display: flex;
    border-top: 1px solid var(--border);
}

.post-buttons button {
    flex: 1;
    border: none;
    background: white;
    padding: 13px;
    cursor: pointer;
    color: var(--muted);
    font-weight: bold;
}

.post-buttons button:hover {
    background: var(--background);
}

/* TITRES */

.title {
    margin-bottom: 25px;
}

.title h1 {
    margin-bottom: 7px;
}

.title p {
    color: var(--muted);
}

/* CARDS */

.cards {
    display: grid;
    grid-template-columns: repeat(auto-fit,minmax(220px,1fr));
    gap: 18px;
}

.card,
.friend,
.notifications > div,
.about {
    background: white;
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 22px;
}

.icon {
    font-size: 35px;
    margin-bottom: 15px;
}

.card p {
    color: var(--muted);
    margin-top: 8px;
    line-height: 1.5;
}

/* FRIENDS */

.friend {
    text-align: center;
}

.friend img {
    width: 110px;
    height: 110px;
    border-radius: 50%;
}

.friend p {
    color: var(--muted);
    margin: 5px;
}

.friend button {
    margin-top: 12px;
    border: none;
    background: var(--blue);
    color: white;
    padding: 10px 15px;
    border-radius: 8px;
}

/* CHAT */

.chat {
    background: white;
    border: 1px solid var(--border);
    border-radius: 14px;
    overflow: hidden;
}

.chat-user {
    display: flex;
    gap: 12px;
    align-items: center;
    padding: 15px;
    border-bottom: 1px solid var(--border);
}

.chat-user img {
    width: 45px;
    height: 45px;
    border-radius: 50%;
}

.chat-user small {
    display: block;
    color: #31a24c;
}

.chat-messages {
    min-height: 350px;
    padding: 20px;
}

.received,
.sent {
    max-width: 70%;
    padding: 11px 15px;
    border-radius: 18px;
    margin-bottom: 10px;
}

.received {
    background: var(--background);
}

.sent {
    margin-left: auto;
    background: var(--blue);
    color: white;
}

.chat-input {
    display: flex;
    gap: 10px;
    padding: 12px;
    border-top: 1px solid var(--border);
}

.chat-input input {
    flex: 1;
    border: none;
    outline: none;
    background: var(--background);
    border-radius: 25px;
    padding: 12px;
}

.chat-input button {
    width: 44px;
    border: none;
    border-radius: 50%;
    background: var(--blue);
    color: white;
}

/* NOTIFICATIONS */

.notifications {
    display: grid;
    gap: 10px;
}

/* GALLERY */

.gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit,minmax(200px,1fr));
    gap: 12px;
}

.gallery img {
    width: 100%;
    height: 230px;
    object-fit: cover;
    border-radius: 12px;
}

/* BLOG */

.blog {
    background: white;
    border: 1px solid var(--border);
    border-radius: 14px;
    overflow: hidden;
}

.blog img {
    width: 100%;
    height: 300px;
    object-fit: cover;
}

.blog div {
    padding: 22px;
}

.blog span {
    color: var(--blue);
    font-weight: bold;
}

.blog h2 {
    margin: 10px 0;
}

.blog p {
    color: var(--muted);
    line-height: 1.6;
}

.blog button {
    margin-top: 15px;
    border: none;
    background: var(--blue);
    color: white;
    padding: 10px 17px;
    border-radius: 8px;
}

/* PROFILE */

.cover {
    height: 300px;
    border-radius: 18px 18px 0 0;
    background:
        linear-gradient(rgba(0,0,0,.25),rgba(0,0,0,.25)),
        url("https://images.unsplash.com/photo-1519389950473-47ba0277781c?auto=format&fit=crop&w=1200&q=80");
    background-size: cover;
    background-position: center;
    position: relative;
}

.avatar {
    position: absolute;
    left: 30px;
    bottom: -65px;
}

.avatar img {
    width: 130px;
    height: 130px;
    border-radius: 50%;
    border: 5px solid white;
}

.profile {
    background: white;
    padding: 75px 25px 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.profile p {
    color: var(--muted);
}

.profile button {
    border: none;
    background: var(--blue);
    color: white;
    padding: 10px 16px;
    border-radius: 8px;
}

.stats {
    background: white;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    display: flex;
    justify-content: space-around;
    padding: 18px;
    text-align: center;
}

.stats strong {
    display: block;
    font-size: 20px;
}

/* MOBILE */

.mobile-nav {
    display: none;
}

@media(max-width:800px) {

    .topbar {
        padding: 0 10px;
    }

    .brand strong {
        display: none;
    }

    .search {
        width: 45%;
    }

    .sidebar {
        display: none;
    }

    main {
        margin-left: 0;
        padding: 82px 10px 80px;
    }

    .mobile-nav {
        position: fixed;
        z-index: 2000;
        display: flex;
        bottom: 0;
        left: 0;
        right: 0;
        height: 65px;
        background: white;
        border-top: 1px solid var(--border);
        justify-content: space-around;
    }

    .mobile-nav button {
        border: none;
        background: transparent;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

    .mobile-nav small {
        font-size: 9px;
        margin-top: 3px;
    }

    .hero {
        padding: 22px;
    }

    .hero h1 {
        font-size: 22px;
    }

    .big-logo {
        width: 65px;
        height: 65px;
        font-size: 42px;
    }

    .create-actions {
        flex-wrap: wrap;
    }

    .create-actions .publish {
        width: 100%;
        margin-left: 0;
    }

    .post-buttons button {
        font-size: 12px;
    }
}

/* DARK MODE */

body.dark {
    --background: #18191a;
    --white: #242526;
    --text: #e4e6eb;
    --muted: #b0b3b8;
    --border: #3e4042;
}

body.dark .topbar,
body.dark .sidebar,
body.dark .create,
body.dark .post,
body.dark .card,
body.dark .friend,
body.dark .chat,
body.dark .notifications > div,
body.dark .blog,
body.dark .profile,
body.dark .stats,
body.dark .about,
body.dark .mobile-nav {
    background: #242526;
    color: #e4e6eb;
}

body.dark .post-buttons button {
    background: #242526;
    color: #b0b3b8;
}
```
